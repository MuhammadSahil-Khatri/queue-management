# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:3000

# Supabase PostgreSQL Connection String (Transaction Pooler - port 6543)
# Used by Express API & Prisma Client at runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Direct Connection String (Direct Connection - port 5432)
# Used exclusively for Prisma migrations (prisma migrate dev / deploy)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secrets (Generate strong random 64-char strings in production)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-in-production-min-32-chars"

# Node Environment
NODE_ENV=development
